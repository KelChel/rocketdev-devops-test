# Copy this file to .env and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=rocketdev

MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=CHANGE_ME_DB_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Address or CIDR allowed to open /wp-admin/ and /wp-login.php.
# Replace it with the public address from which you administer WordPress.
WP_ADMIN_ALLOWED_CIDR=127.0.0.1/32
